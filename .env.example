# =================================================================
# BOPCLIENTS PRODUCTION RUNTIME ENVIRONMENT CONFIGURATION
# =================================================================

# Application Environment (development, test, staging, production)
BOPCLIENTS_ENV=development

# Database Connection (SQLite file path or connection string)
DATABASE_URL=:memory:

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Comma-separated list of active public signal providers
# Available options: official_website, government_procurement, public_news, gemini
ENABLED_PUBLIC_SIGNAL_PROVIDERS=official_website

# SAM.gov Opportunities API Key (Required for government_procurement provider)
SAM_GOV_API_KEY=

# Google Gemini API Key (Required for gemini provider)
GEMINI_API_KEY=

# Public News Provider Backend Endpoint (Required for public_news provider)
PUBLIC_NEWS_BACKEND_URL=

# Monitoring Worker Run Budgets & Lease Settings
MONITORING_WORKER_BATCH_SIZE=25
MONITORING_WORKER_MAX_ITEMS=100
MONITORING_WORKER_MAX_SECONDS=600
MONITORING_LEASE_DURATION_SECONDS=300
MONITORING_LEASE_RENEW_BEFORE_SECONDS=90
